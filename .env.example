# Строка подключения к PostgreSQL
XWORS_DATABASE_URL=postgresql://user:password@localhost:5432/database?sslmode=require
# Секрет для подписи cookie и CSRF-токенов (минимум 32 случайных символа)
AUTH_SECRET=replace-with-at-least-32-random-characters

# Vercel Blob — хранилище картинок (только на сервере; не выводите эти значения в JavaScript браузера)
PUBLIC_BLOB_READ_WRITE_TOKEN=
PUBLIC_BLOB_STORE_ID=
# Нужно только при добавлении webhook-эндпоинта Vercel Blob с проверкой подписи
PUBLIC_BLOB_WEBHOOK_PUBLIC_KEY=
