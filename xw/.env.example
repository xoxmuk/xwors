XWORS_DATABASE_URL=postgresql://user:password@localhost:5432/database?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters

# Vercel Blob (server-side only; do not expose these values in browser JavaScript)
PUBLIC_BLOB_READ_WRITE_TOKEN=
PUBLIC_BLOB_STORE_ID=
# Only needed if you add a Vercel Blob webhook endpoint with signature verification
PUBLIC_BLOB_WEBHOOK_PUBLIC_KEY=
